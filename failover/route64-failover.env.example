# Copy to /etc/default/route64-failover and edit.
PRIMARY_IFACE="wg0"
BACKUP_IFACE="wg2"

# Use a stable IPv6 target that responds to ICMPv6 from both Route64 tunnels.
PROBE_TARGET="2606:4700:4700::1111"

CHECK_INTERVAL="10"
FAIL_THRESHOLD="3"
RECOVER_THRESHOLD="5"
PING_COUNT="2"
PING_TIMEOUT="3"

# Runtime state; normally leave unchanged.
STATE_FILE="/run/route64-failover.active"
